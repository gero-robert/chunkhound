# Copy to <memory-dir>/memory-serve.env and fill in values.
# Format: KEY=value (no shell quoting). Loaded with a strict allowlist parser —
# never sourced/executed. Only these keys are read:
#
#   CHUNKHOUND_MEMORY_DIR
#   CHUNKHOUND_MEMORY_TOKEN
#   CHUNKHOUND_MEMORY_HOST
#   CHUNKHOUND_MEMORY_PORT
#   CHUNKHOUND_MEMORY_PUBLIC_HOST
#
# Used by docs/memory/serve.sh and docs/memory/serve.ps1
# Precedence: CLI flags > process environment > this file > defaults

CHUNKHOUND_MEMORY_DIR=
CHUNKHOUND_MEMORY_TOKEN=
CHUNKHOUND_MEMORY_HOST=0.0.0.0
CHUNKHOUND_MEMORY_PORT=8765
CHUNKHOUND_MEMORY_PUBLIC_HOST=127.0.0.1

# Optional: path to repo checkout when scripts are not under a full clone
# CHUNKHOUND_REPO=
